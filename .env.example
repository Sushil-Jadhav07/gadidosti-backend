# Server
PORT=5000
NODE_ENV=development

# Public base URL of this API — used to build absolute links (e.g. KYC document urls).
# Set to https://apigadidosti.asynk.in in production. Falls back to the
# request's own protocol+host if left unset.
API_BASE_URL=http://localhost:5000
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here



# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ssk_logistics
DB_USER=postgres
DB_PASSWORD=your_password

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_change_this
JWT_REFRESH_EXPIRES_IN=30d

# OTP (mock - replace with Twilio/MSG91 in production)
OTP_EXPIRY_MINUTES=10

# Google Sign-In (Google Cloud Console → Credentials → OAuth 2.0 Client ID)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Provider selection (each defaults to "fake" — a working local/dev implementation
# with no external credentials required). Swap in a real provider by changing only
# the value here and adding the corresponding implementation under src/providers/<type>/.
PAYMENT_PROVIDER=fake
SMS_PROVIDER=fake
# STORAGE_PROVIDER=fake writes to local disk (backend/uploads) — lost on every
# deploy/restart on platforms with an ephemeral filesystem (e.g. Render).
# STORAGE_PROVIDER=postgres stores files in the kyc_files table instead (run
# db/17kyc_files.sql first) — persists across deploys, no external service needed.
STORAGE_PROVIDER=fake
LOCATION_PROVIDER=fake
# PUSH_PROVIDER=fake just logs what would have been sent — no credentials needed.
# PUSH_PROVIDER=firebase requires the three vars below, from a Firebase project's
# Service Account key (Firebase Console → Project Settings → Service Accounts →
# Generate new private key → downloads a JSON file with these three fields).
PUSH_PROVIDER=fake
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private_key value from the JSON as one line — keep the literal \n sequences
# (don't turn them into real line breaks); FirebasePushProvider converts them back at startup.
# NEVER commit a real value here — this file is tracked by git. Put real credentials only in
# your local .env (gitignored) or directly in the server's own .env file over SSH.
FIREBASE_PRIVATE_KEY=

# Bolt Pull API (Roadcast Tech Solutions) — third-party GPS tracker device feed, see
# src/providers/tracking/BoltTrackingProvider.js. No provider-selection toggle (single fixed
# vendor, not swappable) — just needs these two credentials to work.
# NEVER commit real values here — put them only in your local .env (gitignored).
BOLT_API_USERNAME=
BOLT_API_PASSWORD=

# Email (invoices, "email me a copy" receipts) — see src/providers/email/.
# EMAIL_PROVIDER=fake (default) just logs what would have been sent — no credentials needed.
# EMAIL_PROVIDER=smtp requires the vars below — works with any standard SMTP provider
# (Gmail app password, SendGrid, Resend's SMTP relay, etc.)
EMAIL_PROVIDER=fake
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
# NEVER commit a real value here — put it only in your local .env (gitignored).
SMTP_PASSWORD=
EMAIL_FROM=
